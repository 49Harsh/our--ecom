{
  "name": "r-ecom",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm --prefix apps/api run start:prod",
    "start:prod": "npm --prefix apps/api run start:prod",
    "lint": "turbo run lint",
    "api:dev": "npm --prefix apps/api run start:dev",
    "api:build": "npm --prefix apps/api run build",
    "api:start": "npm --prefix apps/api run start:prod",
    "web:dev": "npm --prefix apps/website run dev",
    "web:build": "npm --prefix apps/website run build"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
